
APP_ENV=development
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_sync
DB_USERNAME=postgres
DB_PASSWORD=replace_with_local_database_password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SYNC_TOPIC=hubspot.sync.requested
KAFKA_CONSUMER_GROUP=hubspot-integration-group

HUBSPOT_ACCESS_TOKEN=replace_with_local_hubspot_token
HUBSPOT_API_BASE_URL=https://api.hubapi.com

SYNC_CRON_EXPRESSION=*/30 * * * *
SYNC_TIMEZONE=Asia/Kolkata
